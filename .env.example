# STACKIT Authentication & Regional Configuration
STACKIT_PROJECT_ID=your-stackit-project-id
STACKIT_REGION=eu01

# Option A: KeyAuth Flow (Recommended - Service Account Key JSON File)
STACKIT_SERVICE_ACCOUNT_KEY_PATH=/path/to/service_account_key.json

# Option B: TokenAuth Flow (Service Account Bearer Token)
# STACKIT_SERVICE_ACCOUNT_TOKEN=your-service-account-bearer-token
# STACKIT_SERVICE_ACCOUNT_TOKEN_FILE=/etc/secrets/stackit-token

# PostgreSQL Database Credentials
STACKIT_POSTGRES_USER=postgres
STACKIT_POSTGRES_PASSWORD=your-postgres-password
STACKIT_POSTGRES_SSLMODE=require

# Alternatively, mount credentials from secret files:
# STACKIT_POSTGRES_USER_FILE=/etc/secrets/pguser
# STACKIT_POSTGRES_PASSWORD_FILE=/etc/secrets/pgpassword

# Local Dump Storage Directory
POSTGRES_DUMP_DIR=dumps

# Optional Operation Timeouts
STACKIT_OPERATION_POLL_INTERVAL_SECONDS=10
STACKIT_OPERATION_TIMEOUT_SECONDS=600
